{
  "manifest_version": 3,
  "name": "Resell Tracker Sync",
  "version": "1.0.0",
  "description": "Auto-syncs Amazon and Walmart orders to your Resell Tracker instance",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.walmart.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/gp/css/order-history*",
        "https://www.amazon.com/your-orders/orders*",
        "https://www.amazon.com/gp/your-account/order-history*"
      ],
      "js": ["content/amazon.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.walmart.com/orders*",
        "https://www.walmart.com/account/order-history*"
      ],
      "js": ["content/walmart.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Resell Tracker Sync"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
