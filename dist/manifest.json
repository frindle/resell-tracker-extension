{
  "manifest_version": 3,
  "name": "Reselling Tracker Sync",
  "version": "1.1.35",
  "description": "Auto-syncs Amazon and Walmart orders to your Resell Tracker instance",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.walmart.com/*",
    "https://www.costco.com/*",
    "https://ecom-api.costco.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*"
      ],
      "js": [
        "content/amazon.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.walmart.com/*"
      ],
      "js": [
        "content/walmart.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.costco.com/myaccount*"
      ],
      "js": [
        "content/costco-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.costco.com/myaccount*"
      ],
      "js": [
        "content/costco.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bigskybuyers.com/*"
      ],
      "js": [
        "content/bigskybuyers.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.cashbackmonitor.com/cashback-store/*"
      ],
      "js": [
        "content/cashbackmonitor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Reselling Tracker Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}